# Inside the existing HTTPS receiver site. Preserve its other routes.
# Install web/tv/ as /var/www/sapflow-tv (directories 0755, files 0644).
redir /tv /tv/ 308
handle /tv/* {
    # If the enclosing site sets CSP, make that a ?Content-Security-Policy
    # default. A deferred, unconditional outer CSP would overwrite this one.
    header {
        Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; connect-src 'self' wss://{host}; media-src 'self' blob:; img-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'none'"
        Referrer-Policy no-referrer
        X-Content-Type-Options nosniff
        Cache-Control no-store
        defer
    }
    @tv_presence path /tv/audience /tv/swarm/*
    handle @tv_presence {
        reverse_proxy 127.0.0.1:28777 {
            header_up -X-Forwarded-For
            header_up -X-Real-IP
            header_up -CF-Connecting-IP
        }
    }
    @tv_media path /tv/live/event-tv/*
    handle @tv_media {
        uri strip_prefix /tv
        reverse_proxy 127.0.0.1:28888 {
            header_up -X-Forwarded-For
            header_up -X-Real-IP
            header_up -CF-Connecting-IP
        }
    }
    # Explicit asset allowlist: private control routes and other streams stay shut.
    @tv_assets path /tv/ /tv/player.css /tv/player.mjs /tv/version.mjs /tv/audience.mjs /tv/network.mjs /tv/controls.mjs /tv/ident.mjs /tv/loading-ident.mp4 /tv/playlist.mjs /tv/cmaf-player.mjs /tv/tone.mjs /tv/connection.mjs /tv/peers.mjs /tv/off-air.png /tv/now-streaming.png /tv/LICENSE.txt /tv/licences.html /tv/vendor/relayswarm-hls-swarm-0.4.4.mjs /tv/vendor/relayswarm-core-0.4.4.wasm /tv/vendor/THIRD-PARTY-LICENCES.txt
    handle @tv_assets {
        uri strip_prefix /tv
        root * /var/www/sapflow-tv
        file_server
    }
    handle {
        respond "Not found" 404
    }
}

# Optional receiver-side RelaySwarm mirror. Never point this at a Mac address.
handle /media/* {
    reverse_proxy 127.0.0.1:28777 {
        header_up -X-Forwarded-For
        header_up -X-Real-IP
        header_up -CF-Connecting-IP
    }
}
