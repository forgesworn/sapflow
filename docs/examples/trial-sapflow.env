# sapflow settings for the trial (docs/trial-plan.md, section 2.3).
# Copy to the host as <sapflow-env-file>, mode 600, and replace every
# <placeholder>. Never commit the filled-in copy.

# The same publisher as mediamtx's authInternalUsers, so one stream key works
# on both servers. Letters and digits only.
SAPFLOW_PUBLISH_USER=<publisher>
SAPFLOW_PUBLISH_PASS=<publisher-password>

# v4v's stream-health endpoint on the private network (plain http only).
# {eventId} is the last path segment; the secret is appended as token=.
SAPFLOW_CALLBACK_URL=http://<app>:<app-port>/api/public/live-events/{eventId}/stream-health
SAPFLOW_CALLBACK_SECRET=<callback-secret>

# Equal to v4v's PULSEWIRE_LIVE_RECONNECT_GRACE_SECONDS.
SAPFLOW_RECONNECT_GRACE=90

# Recordings land where v4v imports them; mount <recordings-dir> here.
SAPFLOW_RECORDINGS=/recordings
# The programme path, if production has one (comma-separated, trailing *).
# SAPFLOW_RECORD_SKIP=<programme-path>

# SRT: a long random passphrase (10 to 79 bytes), optional for encoders.
SAPFLOW_SRT_PASSPHRASE=<srt-passphrase>
SAPFLOW_SRT_ENCRYPTION=optional

# Viewers on hyper (the default) for the first show; listed to be explicit.
SAPFLOW_HTTP_IMPL=hyper

# Defaults, listed so the trial's values are on record.
SAPFLOW_SEGMENT_COUNT=24
SAPFLOW_HEALTH_INTERVAL=30
SAPFLOW_RECORD_DELETE_AFTER=7d
